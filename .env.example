# copy to .env — loaded by Taskfile. OPENROUTER_API_KEY comes from your shell (never commit it).
#
# This is the DEV stack: task infra:up Postgres and MinIO. It has to be said out
# loud, because the binary no-config default is now `local` — sqlite in a file,
# artifacts in a folder — so a downloaded binary boots with nothing beside it.
# Working on the repo means running against the real pair.
WFX_MODE=server
DATABASE_URL=postgres://bfp:bfp@127.0.0.1:5460/bfp?sslmode=disable
S3_ENDPOINT=127.0.0.1:9030
S3_ACCESS_KEY=bfp
S3_SECRET_KEY=bfpbfpbfp
S3_BUCKET=bfp-artifacts
WFX_MODEL=anthropic/claude-sonnet-4.5
