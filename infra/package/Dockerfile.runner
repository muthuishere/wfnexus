# A worker in a container, from the binary already in this tarball.
#
# A worker is not a replica of the server: it is a machine that holds a
# TOOLCHAIN. Add the agent CLIs this label is meant to provide — that is the
# whole reason to run one.
FROM alpine:3.21

RUN apk add --no-cache git bash curl ca-certificates nodejs npm python3 \
 && adduser -D -u 10001 wfx

# The CLIs this worker's label promises, e.g.
#   RUN npm i -g @devin/cli @anthropic-ai/claude-code

COPY bin/wfx-runner-linux /usr/local/bin/wfx-runner
RUN chmod +x /usr/local/bin/wfx-runner

# The runner's home is created and owned HERE, before the volume is mounted.
# A named volume mounted over a directory inherits that directory's ownership
# from the image — but only if it exists in the image. Without this the volume
# is created root-owned, the container runs as wfx, and the first thing it does
# is fail to write its own config.
RUN mkdir -p /home/wfx/.wfx-runner && chown -R wfx:wfx /home/wfx

USER wfx
ENV WFX_RUNNER_HOME=/home/wfx/.wfx-runner

# join once, then take work until stopped. `run` blocks for as long as the
# worker lives, which is correct here — the container IS the worker.
ENTRYPOINT ["/bin/sh", "-c", \
  "wfx-runner status >/dev/null 2>&1 || wfx-runner join --url \"$WFX_URL\" --token \"$WFX_TOKEN\" --labels \"${WFX_LABELS:-self-hosted}\" ${WFX_NAME:+--name \"$WFX_NAME\"}; exec wfx-runner run"]
