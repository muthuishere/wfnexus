bin/
node_modules/
apps/ui/dist/
.env
*.env

# Local-only module replacements (never commit a machine path in go.mod)
go.work
go.work.sum

# ctx-optimize: commit the config, not the generated store
.ctxoptimize/*
!.ctxoptimize/config.json
!.ctxoptimize/instructions.md

# Agent worktrees, created per-task and discarded
.claude/worktrees/


# A `go build` inside cmd/wfx drops the binary beside its source; never commit it
apps/api/cmd/wfx/wfx
apps/api/cmd/wfx/wfx.exe
