# A worker in a container — the same thing `wfx-runner join` makes of a laptop
# or a Windows VM, for when the machine you want is a pod.
#
# It holds the tools the steps it takes will use: git, a shell, and whichever
# agent CLI you want available on this label. That is the whole reason workers
# exist — the toolchain lives with the machine, not with the platform.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api ./
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -o /out/wfx-runner ./cmd/wfx-runner

FROM alpine:3.21
RUN apk add --no-cache git bash curl ca-certificates nodejs npm python3 \
 && adduser -D -u 10001 wfx
# Add the agent CLIs this label is meant to provide, from the same allowlist
# the server image uses (apps/api/internal/engine/installers.go), e.g.
#   RUN wfx-runner tools --system claude devin codex
#   USER wfx
#   ENV PATH=/home/wfx/.local/bin:$PATH
#   RUN wfx-runner tools --user claude devin codex && wfx-runner tools --check claude devin codex
# devin has no npm package: its installer is curl -fsSL https://cli.devin.ai/install.sh | bash
COPY --from=build /out/wfx-runner /usr/local/bin/wfx-runner
# Every other tool (gh, jq, rg, ...) and any config come from carry's bucket
# (CARRY_REPO etc.); unset, carry just runs the runner.
COPY --from=ghcr.io/muthuishere/carry:0.1.1 /carry /usr/local/bin/carry
# The runner's home is created and owned HERE, before the volume is mounted.
# A named volume mounted over a directory inherits that directory's ownership
# from the image — but only if it exists in the image. Without this the volume
# is created root-owned, the container runs as wfx, and the first thing it does
# is fail to write its own config.
RUN mkdir -p /home/wfx/.wfx-runner && chown -R wfx:wfx /home/wfx

USER wfx
ENV WFX_RUNNER_HOME=/home/wfx/.wfx-runner
# join writes the registration, then run takes work until stopped, under
# carry. Its state is per worker: CARRY_STATE, else the worker's name.
ENTRYPOINT ["/bin/sh", "-c", \
  "wfx-runner status >/dev/null 2>&1 || wfx-runner join --url \"$WFX_URL\" --token \"$WFX_TOKEN\" --labels \"${WFX_LABELS:-self-hosted}\" ${WFX_NAME:+--name \"$WFX_NAME\"}; export CARRY_STATE=\"${CARRY_STATE:-${WFX_NAME:-$(hostname)}}\"; exec carry run -- wfx-runner run"]
