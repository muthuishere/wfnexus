# Settings for `docker compose up -d` (docker-compose.yml beside this file).
# Copy to .env and edit; .env is gitignored. Every line is optional.

# Where the UI and API listen on this machine: http://localhost:8090
WFX_PORT=8090
# 127.0.0.1 keeps it on this machine; 0.0.0.0 lets workers on other machines join.
WFX_BIND=127.0.0.1
# A second stack beside the first needs its own project name (and port).
WFX_PROJECT_NAME=wfnexus

# The free defaults: agent steps on opencode's free models (no key, no login),
# decisions on the TypeSafe JEV classifier.
WFX_DEFAULT_PROVIDER=opencode-acp
WFX_DEFAULT_CLASSIFIER=jev-direct

# Keys. Leave them empty here and use `wfx env set TYPESAFE_API_KEY` instead:
# that stores them encrypted and never puts them in a file.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

PG_PASSWORD=wfx
